# Copy this file to .env. Do not commit real credentials.
APP_NAME=DEV Placement OS
APP_ENV=development
DATABASE_URL=postgresql+psycopg://dev_placement:dev_placement@localhost:5432/dev_placement
SQL_ECHO=false

# Judge0 is the isolated Phase 3 execution provider. Leave blank when not running it.
JUDGE0_BASE_URL=

# Phase 6 tutor provider. Keep GOOGLE_API_KEY in the untracked .env only.
TUTOR_PROVIDER=gemini
TUTOR_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
TUTOR_TIMEOUT_SECONDS=20
TUTOR_MAX_RETRIES=2
TUTOR_MAX_INPUT_CHARS=30000
TUTOR_MAX_OUTPUT_TOKENS=2048
HINT_LEVEL_6_REQUIRES_LEVEL_5=true
