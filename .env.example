# Copy this file to .env. Do not commit real credentials.
APP_NAME=DEV Placement OS
APP_ENV=development
DATABASE_URL=postgresql+psycopg://dev_placement:dev_placement@localhost:5432/dev_placement
SQL_ECHO=false

# Judge0 is the isolated Phase 3 execution provider. Leave blank when not running it.
JUDGE0_BASE_URL=

# Zero-cost tutoring. No hosted request until free account AND model are confirmed.
ZERO_COST_MODE=true
TUTOR_PROVIDER=zero_cost
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FREE_TIER_CONFIRMED=false
GROQ_TIMEOUT_SECONDS=8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=60
# Set this in the Ollama daemon's environment too, then restart it.
OLLAMA_NO_CLOUD=1

# Legacy Gemini adapter is prohibited while ZERO_COST_MODE=true.
TUTOR_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
TUTOR_TIMEOUT_SECONDS=20
TUTOR_MAX_RETRIES=2
TUTOR_MAX_INPUT_CHARS=30000
TUTOR_MAX_OUTPUT_TOKENS=2048
HINT_LEVEL_6_REQUIRES_LEVEL_5=true

# Phase 8 local UI. Set the learner ID printed by explicit demo provisioning.
UI_API_BASE_URL=http://127.0.0.1:8000
UI_LEARNER_ID=
UI_REQUEST_TIMEOUT_SECONDS=90
